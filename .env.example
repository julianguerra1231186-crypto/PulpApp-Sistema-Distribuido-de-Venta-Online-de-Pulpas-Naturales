# =========================================================
# Zentrix SaaS — Variables de Entorno
# =========================================================
# Copia este archivo como .env y ajusta los valores.
# Docker Compose lee automáticamente el archivo .env
# =========================================================

# ── Base de Datos ──
POSTGRES_DB=pulpapp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# ── DataSource (usado por microservicios) ──
# Local (Docker Compose):
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pulpapp_db
# Cloud (Google Cloud SQL):
# SPRING_DATASOURCE_URL=jdbc:postgresql://34.61.208.220:5432/zentrix
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=1234

# ── JWT ──
JWT_SECRET=cGVwcGVyTWludFB1bHBBcHBTZWNyZXRLZXkyMDI2IVhZWg==
JWT_EXPIRATION_MS=86400000

# ── Tenant ──
TENANT_DEFAULT_ID=1

# ── Puertos (solo para referencia, docker-compose los define) ──
# MS_USERS_PORT=8081
# MS_PRODUCTS_PORT=8082
# MS_ORDERS_PORT=8083
# GATEWAY_PORT=8080
# FRONTEND_PORT=3000
